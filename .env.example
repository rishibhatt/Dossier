# Copy to .env.local for local work. On Netlify: Site configuration, Environment variables.
# NEXT_PUBLIC_* values ship to every browser. Never give a secret that prefix (scripts/check-env.mjs stops the build).

# --- Site ---
# Production: https://dossier-cv.com (no trailing slash). Must match Supabase Site URL and redirect allow list.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Supabase (Project Settings, API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row level security: quotas, publishing, billing, admin.
SUPABASE_SERVICE_ROLE_KEY=
# Server only. 32+ random characters; salts the hashed IPs used for rate limits.
RATE_LIMIT_SALT=

# --- Admin console (admin.<domain>) ---
# Comma-separated Supabase user ids allowed in the console (they also need an authenticator code).
ADMIN_USER_IDS=

# --- LLM providers (server only) ---
GROQ_API_KEY=
# Optional: several Groq keys, comma-separated, tried in turn.
GROQ_API_KEYS=
OPENROUTER_API_KEY=
OPENROUTER_APP_NAME=Dossier
# Optional model chains, e.g. groq:openai/gpt-oss-20b,openrouter:...
LLM_MODELS=
LLM_MODELS_RESUME=
# 1 logs LLM routing and latency to the server console. Keep 0 in production.
LLM_DEBUG=0

# --- Email (Brevo, server only) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Dossier
# Where contact-form messages go. Defaults to the support email.
CONTACT_INBOX=
# 0 turns off the "new sign-in" notice email.
EMAIL_SIGNIN_ALERTS=1
# Bearer token for /api/cron/emails (Netlify scheduled function daily-emails).
CRON_SECRET=

# --- Billing (Razorpay) ---
# Key id is public (checkout needs it); the secrets are server only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# 1 allows USD checkout.
NEXT_PUBLIC_RAZORPAY_INTERNATIONAL=0
# 1 once paid plans are on sale: a production build without the Razorpay keys then fails.
BILLING_LIVE=0

# --- Analytics and verification (public IDs) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Security headers ---
# 1 enforces the Content Security Policy (otherwise report-only). Turn on after a week of clean /api/csp-report logs.
CSP_ENFORCE=0

# --- Local only ---
# 1 lifts plan quotas in `next dev` (ignored in production builds).
DEV_UNLIMITED=0

# Supabase Dashboard, Authentication, URL configuration:
# - Site URL: match NEXT_PUBLIC_SITE_URL
# - Redirect URLs: include `${NEXT_PUBLIC_SITE_URL}/auth/callback`
